# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id
DISCORD_ADMIN_USER_IDS=user_id_1,user_id_2

# Hyperliquid
HYPERLIQUID_PRIVATE_KEY=your_wallet_private_key
HYPERLIQUID_TESTNET=true

# Configuration
ANALYSIS_INTERVAL_HOURS=4
ASSETS_TO_TRADE=BTC,ETH,SOL
LOG_LEVEL=INFO
DATABASE_PATH=data/trader.db

# LLM Configuration (OpenRouter)
# See available models at https://openrouter.ai/models
# Recommended: anthropic/claude-3.5-sonnet (good balance of cost/performance)
# Budget option: anthropic/claude-3-haiku or google/gemini-flash-1.5
LLM_MODEL=anthropic/claude-sonnet-4
LLM_MAX_TOKENS=1024

# Paper trading mode (set to false for real trading)
PAPER_TRADING=true

# Risk Configuration
MAX_POSITION_SIZE_USD=1000
MAX_TOTAL_EXPOSURE_USD=2000
MAX_LEVERAGE=5
MAX_DAILY_DRAWDOWN_PCT=5
MAX_WEEKLY_DRAWDOWN_PCT=15
MAX_TOTAL_DRAWDOWN_PCT=30
MAX_TRADES_PER_DAY=2
MIN_TIME_BETWEEN_TRADES_HOURS=4
DEFAULT_STOP_LOSS_PCT=3
DEFAULT_TAKE_PROFIT_PCT=6
